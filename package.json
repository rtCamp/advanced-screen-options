{
	"name": "advanced-screen-options",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/rtCamp/advanced-screen-options.git"
	},
	"engines": {
		"node": ">=22.0.0",
		"npm": ">=10.0.0"
	},
	"files": [
		"actions/",
		"build/",
		"inc/",
		"vendor/",
		"languages/",
		"readme.txt",
		"advanced-screen-options.php",
		"uninstall.php",
		"composer.json"
	],
	"dependencies": {
		"@wordpress/api-fetch": "^7.40.0",
		"@wordpress/components": "^45.0.0",
		"@wordpress/element": "^6.46.0",
		"@wordpress/i18n": "^6.13.0",
		"@wordpress/icons": "^11.8.0",
		"dompurify": "^3.5.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@babel/core": "^7.29.6",
		"@types/react": "^18.3.32",
		"@types/react-dom": "^18.3.7",
		"@wordpress/babel-preset-default": "^8.40.0",
		"@wordpress/browserslist-config": "^6.40.0",
		"@wordpress/env": "^12.2.0",
		"@wordpress/eslint-plugin": "^24.5.0",
		"@wordpress/scripts": "^31.8.0",
		"browserslist": "^4.29.6",
		"cross-env": "^10.1.0",
		"css-minimizer-webpack-plugin": "^8.0.0",
		"eslint": "^8.57.1",
		"eslint-plugin-eslint-comments": "^3.2.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jest": "^27.9.0",
		"globals": "^17.14.0",
		"npm-run-all": "^4.1.5",
		"rimraf": "^6.1.4",
		"typescript": "^5.9.3",
		"webpack-remove-empty-scripts": "^1.1.1"
	},
	"scripts": {
		"build:dev": "cross-env NODE_ENV=development npm-run-all 'build:!(dev|prod)'",
		"build:js": "wp-scripts build --config ./webpack.config.js",
		"build:prod": "npm run clean && cross-env NODE_ENV=production npm-run-all 'build:!(dev|prod)' && composer install --no-dev --optimize-autoloader",
		"clean": "rimraf build",
		"i18n:make-pot": "wp-env run cli wp i18n make-pot . ./languages/screen-options.pot --exclude=node_modules,vendor,tests --ignore-domain=default",
		"i18n:make-json": "wp-env run cli wp i18n make-json languages/ --no-purge",
		"lint:css": "wp-scripts lint-style",
		"lint:css:fix": "npm run lint:css -- --fix",
		"lint:js:fix": "npm run lint:js -- --fix",
		"lint:js": "wp-scripts lint-js",
		"lint:js:types": "tsc --noEmit",
		"lint:php:fix": "composer run-script format",
		"lint:php:stan": "composer run-script phpstan",
		"lint:php": "composer run-script lint",
		"lint": "npm-run-all --parallel lint:*",
		"plugin-zip": "npm run build:prod && wp-scripts plugin-zip",
		"start:js": "wp-scripts start --config ./webpack.config.js",
		"start": "npm-run-all --parallel start:*",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/$(basename \"$(pwd)\")/ composer run-script test",
		"wp-env": "wp-env"
	},
	"overrides": {
		"@babel/core": "^7.29.6",
		"@babel/runtime": "^7.27.6",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"webpack-dev-server@<=5.2.0": ">=5.2.1",
		"fast-xml-parser": ">=5.3.4",
		"minimatch": ">=10.2.1",
		"serialize-javascript": ">=7.0.3",
		"adm-zip": ">=0.6.1",
		"basic-ftp": ">=6.2.4",
		"isomorphic-git": ">=1.38.6",
		"linkify-it": ">=5.0.2",
		"markdown-it": "^14.3.3",
		"qs@<=6.16.0": ">=6.16.1",
		"zod": ">=4.6.6",
		"@opentelemetry/core": "^2.8.0",
		"@opentelemetry/instrumentation-knex": ">=0.65.0",
		"@opentelemetry/instrumentation-mongoose": ">=0.66.1",
		"@opentelemetry/instrumentation-mysql": ">=0.67.0",
		"@opentelemetry/instrumentation-mysql2": ">=0.66.1",
		"@opentelemetry/instrumentation-pg": ">=0.72.1",
		"@opentelemetry/instrumentation-tedious": ">=0.40.0",
		"@wordpress/env": {
			"glob": ">=14.0.2"
		},
		"@wp-playground/blueprints": {
			"ajv": ">=8.18.0"
		},
		"@wp-playground/tools": {
			"ajv": ">=8.18.0"
		},
		"@wp-playground/cli": {
			"ajv": ">=8.18.0"
		}
	}
}
